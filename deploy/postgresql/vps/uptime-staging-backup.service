[Unit]
Description=PostgreSQL uptime_staging Daily Local Backup
Requires=postgresql.service
After=postgresql.service

[Service]
Type=oneshot
User=postgres
Group=postgres
UMask=0077
# Installed from deploy/postgresql/vps/uptime-staging-backup.sh.
ExecStart=/usr/local/bin/uptime-staging-backup.sh
ExecStartPost=+/usr/local/bin/uptime-staging-offsite.sh

[Install]
WantedBy=multi-user.target
