# Environment template for Uptime Staging Node API on VPS 217.217.227.164
#
# INSTRUCTIONS FOR OPERATOR:
# Copy this file to `api.env` on the VPS in /opt/uptime-staging/api.env.
# Ensure file permissions are strictly 0600:
#   chmod 0600 /opt/uptime-staging/api.env
# NEVER commit the filled `api.env` to version control.

# ==============================================================================
# 1. Network & Adapter Configuration
# ==============================================================================
ENVIRONMENT=staging
API_HOST=127.0.0.1
API_PORT=3001
API_MAX_BODY_BYTES=1048576
API_TRUSTED_PROXIES=127.0.0.1,::1
API_RECONCILE_INTERVAL_SECONDS=60
API_SHUTDOWN_GRACE_SECONDS=25
PUBLIC_ORIGIN=https://uptime-staging.pages.dev
WEB_ORIGIN=https://uptime-staging.pages.dev

# ==============================================================================
# 2. Ingress Authentication Secret (Gateway Token)
# ==============================================================================
# Shared secret between Cloudflare Worker proxy and Node adapter (min 32 chars).
# Forwarded as `x-uptime-gateway-token` (and `x-gateway-token`).
# Generate with: openssl rand -hex 32
API_GATEWAY_TOKEN=

# ==============================================================================
# 3. PostgreSQL Database Connection
# ==============================================================================
# Local loopback connection to co-located PostgreSQL 18 instance.
# Format: postgresql://uptime_staging_worker:<PASSWORD>@127.0.0.1:5432/uptime_staging
#
# Password source: Protected local operator file:
#   ~/.config/uptime-postgresql/staging-worker-password
POSTGRES_URL=

# Runtime Multi-Tenant Catalog (mounted into container at /app/catalog.json)
POSTGRES_RUNTIME_CATALOG_FILE=/app/catalog.json

# ==============================================================================
# 4. Cryptographic & Session Secrets (min 32 chars each)
# ==============================================================================
# SESSION_SECRET: Signs session cookies (uptime_session, uptime_atproto_session).
# Sourced from staging Cloudflare Worker secret `uptime-staging-oauth-api`.
SESSION_SECRET=

# CREDENTIAL_ENCRYPTION_SECRET: AES-GCM key for encrypted monitor credentials.
# Sourced from deploy/cloudflare/staging/hosted.secrets.env or Worker secret.
CREDENTIAL_ENCRYPTION_SECRET=

# OAUTH_STORAGE_SECRET: Required by ATProto OAuth state store.
# Sourced from staging Cloudflare Worker secret `uptime-staging-oauth-api`.
OAUTH_STORAGE_SECRET=

# ==============================================================================
# 5. Application & Staging Feature Flags
# ==============================================================================
CLOUDFLARE_ACCOUNT_ID=8af9a4d4a03e412bbd3f2a31463ec5b6
INTEREST_CHECK_ONLY=true
BILLING_MODE=mock
CUSTOM_DOMAIN_MODE=mock
CUSTOM_DOMAIN_CNAME_TARGET=status-fallback.staging.internal
OPERATOR_DIDS=did:plc:lmkzmvv6sdxntwtyxpg7fqqq,did:plc:2tvka6iztzewyjsbdu6yowgj
REGIONS_LIST=eu-west,us-east,asia
COORDINATOR_MONITOR_BATCH=50
SESSION_TTL_SECONDS=604800
MIN_AVAILABLE_SLOTS=1

# ==============================================================================
# 6. Optional R2 S3-API Credentials (Reports Storage)
# ==============================================================================
# If configured, all three must be set together. If omitted, /reports/ routes
# answer 503 reports_unavailable, while Pages gateway serves public reports
# via its own R2 binding directly.
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_REPORTS_BUCKET=uptime-staging-reports
# R2_ENDPOINT=https://8af9a4d4a03e412bbd3f2a31463ec5b6.r2.cloudflarestorage.com
