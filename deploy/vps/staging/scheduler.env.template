# Environment template for the Uptime staging minute scheduler on VPS 217.217.227.164
#
# INSTRUCTIONS FOR OPERATOR:
# Copy this file to `scheduler.env` on the VPS in /opt/uptime-staging/scheduler.env.
# Ensure file permissions are strictly 0600:
#   chmod 0600 /opt/uptime-staging/scheduler.env
# Keep it separate from api.env. NEVER commit the filled file to version control.
# Startup errors name the missing or malformed variable and never print its value.

# ==============================================================================
# 1. Scheduler switch
# ==============================================================================
# Required, must be exactly `true` or `false`.
# false: validates every setting below, logs `scheduler_disabled`, dispatches nothing.
# true: dispatches due workspaces at each minute boundary.
# Run exactly one scheduler instance, and set true only after the Cloudflare staging
# coordinator cron is removed and its queue is drained.
SCHEDULER_ENABLED=false
SCHEDULER_SHUTDOWN_GRACE_SECONDS=25

# ==============================================================================
# 2. PostgreSQL (direct connection, no Hyperdrive)
# ==============================================================================
# Format: postgresql://uptime_staging_worker:<PASSWORD>@127.0.0.1:5432/uptime_staging
# Password source: ~/.config/uptime-postgresql/staging-worker-password
POSTGRES_URL=
# Mounted into the container at /app/catalog.json by docker-compose.yml.
POSTGRES_RUNTIME_CATALOG_FILE=/app/catalog.json

# ==============================================================================
# 3. Secrets
# ==============================================================================
# PROBE_SIGNING_SECRET: HMAC key the regional probe Workers verify. Same value as the
# staging hosted coordinator Worker secret (deploy/cloudflare/staging/hosted.secrets.env).
PROBE_SIGNING_SECRET=
# CREDENTIAL_ENCRYPTION_SECRET: same value as api.env (min 32 chars).
CREDENTIAL_ENCRYPTION_SECRET=

# Do NOT set CURRENT_BUDGET_USAGE_JSON. While it is absent and budget enforcement is on,
# the scheduler dispatches maintenance-only jobs and never probes. Staging currently turns
# enforcement off with BUDGET_ENFORCEMENT_DISABLED=true in docker-compose.yml (not here).

# ==============================================================================
# 4. Reports storage (R2 S3 API), all four required
# ==============================================================================
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REPORTS_BUCKET=uptime-staging-reports
R2_ENDPOINT=https://8af9a4d4a03e412bbd3f2a31463ec5b6.r2.cloudflarestorage.com

# ==============================================================================
# 5. Coordinator settings (copied from deploy/cloudflare/staging/hosted-coordinator/wrangler.toml)
# ==============================================================================
ENVIRONMENT=staging
REGIONS_LIST=eu-west,us-east,asia
WORKERS_URL_DOMAIN=david-8af.workers.dev
PROBE_WORKER_NAME_PREFIX=uptime-staging-hosted-probe-
DETAILED_RESULTS_RETENTION_DAYS=1
DNS_DIAGNOSTICS_RETENTION_DAYS=30
REPORT_INTERVAL_SECONDS=60
NOTIFICATION_MAX_ATTEMPTS=8
COORDINATOR_MONITOR_BATCH=50
COORDINATOR_PROBE_CONCURRENCY=32
