{
  "name": "@uptime/api-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./providers": "./src/providers.ts",
    "./credentials": "./src/credentials.ts",
    "./queries": "./src/queries.ts",
    "./monitor-cache": "./src/monitor-cache.ts",
    "./node-bindings": "./src/node-bindings.ts",
    "./r2-s3": "./src/r2-s3.ts"
  },
  "scripts": {
    "build:node": "esbuild src/node-main.ts --bundle --platform=node --target=node24 --format=esm --external:pg-native --sourcemap --outfile=dist/node/server.mjs --banner:js=\"import { createRequire as __createRequire } from 'node:module'; const require = __createRequire(import.meta.url);\"",
    "start:node": "node dist/node/server.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@atproto/jwk-webcrypto": "^0.3.4",
    "@atproto/oauth-client": "^0.8.8",
    "@uptime/cloudflare": "workspace:*",
    "@uptime/contracts": "workspace:*",
    "@uptime/regions": "workspace:*",
    "undici": "7.29.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250829.0",
    "@types/node": "^24.3.0",
    "esbuild": "0.25.12"
  }
}
