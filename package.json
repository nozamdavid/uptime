{
  "name": "multi-region-uptime",
  "description": "Multi-region uptime monitoring on a Node and PostgreSQL VPS with Cloudflare probe Workers",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:postgres": "pnpm --filter @uptime/cloudflare test:postgres",
    "format:check": "prettier --check .",
    "generate:wrangler": "node scripts/generate-wrangler-configs.ts",
    "hash:admin": "node scripts/hash-admin-password.ts"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
