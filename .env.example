# Public HTTPS origin used to build request URLs.
PUBLIC_ORIGIN=https://uptime.example.com
# PostgreSQL connection string for the API.
POSTGRES_URL=postgresql://uptime:replace-me@127.0.0.1:5432/uptime
# Runtime catalog file; use POSTGRES_RUNTIME_CATALOG with JSON instead if needed.
POSTGRES_RUNTIME_CATALOG_FILE=deploy/vps/staging/catalog.json
# At least 32 characters; encrypts stored monitor credentials.
CREDENTIAL_ENCRYPTION_SECRET=replace-with-at-least-32-random-characters
# At least 32 characters; protects OAuth state storage.
OAUTH_STORAGE_SECRET=replace-with-at-least-32-random-characters
# At least 32 random characters; required on requests through the local proxy.
API_GATEWAY_TOKEN=replace-with-at-least-32-random-characters

# API and single-admin authentication
API_HOST=0.0.0.0
API_PORT=3004
# Set true when the browser reaches the app over HTTPS.
SESSION_COOKIE_SECURE=false
ADMIN_EMAIL=admin@example.com
# Generate an Argon2id hash; never commit the plaintext password.
ADMIN_PASSWORD_HASH=
# At least 32 characters; signs session cookies.
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_SECONDS=604800

# Scheduler-to-probe signing and Worker URL suffix
REGIONS_LIST="us-east,us-west,canada-central,eu-west,eu-north,eu-south,asia,asia-east,asia-south"
WORKERS_URL_DOMAIN=account.workers.dev
PROBE_SIGNING_SECRET=
SCHEDULER_POLL_INTERVAL_MS=1000
SCHEDULER_INSTANCE_ID=local-1
SCHEDULER_MAX_CONCURRENT_PROBES=32
