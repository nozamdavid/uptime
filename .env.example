# PostgreSQL must already exist and be reachable from the containers.
DATABASE_URL=postgresql://uptime:replace-me@database.example.com:5432/uptime

# API and single-admin authentication
API_HOST=0.0.0.0
API_PORT=3004
# Set true when the browser reaches the app over HTTPS.
SESSION_COOKIE_SECURE=false
ADMIN_EMAIL=admin@example.com
# Generate an Argon2id hash; never commit the plaintext password.
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
SESSION_TTL_SECONDS=604800

# Scheduler-to-probe signing and Worker URL suffix
REGIONS_LIST="us-east,us-west,canada-central,eu-west,eu-north,eu-south,asia,asia-east,asia-south"
WORKERS_URL_DOMAIN=account.workers.dev
PROBE_SIGNING_SECRET=
PROBE_REQUEST_MAX_SKEW_SECONDS=60
SCHEDULER_POLL_INTERVAL_MS=1000
SCHEDULER_INSTANCE_ID=local-1
SCHEDULER_MAX_CONCURRENT_PROBES=32

# Per-deployment Worker values
PROBE_REGION=us-east
PROBE_MAX_REQUEST_BYTES=65536
PROBE_VERSION=dev
