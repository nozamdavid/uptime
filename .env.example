# PostgreSQL must already exist and be reachable from the containers.
DATABASE_URL=postgresql://uptime:replace-me@database.example.com:5432/uptime

# API and single-admin authentication
API_HOST=0.0.0.0
API_PORT=3000
# Set true when the browser reaches the app over HTTPS.
SESSION_COOKIE_SECURE=false
ADMIN_EMAIL=admin@example.com
# Generate an Argon2id hash; never commit the plaintext password.
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
SESSION_TTL_SECONDS=604800

# Scheduler-to-probe signing and probe endpoints
PROBE_SIGNING_SECRET=
PROBE_REQUEST_MAX_SKEW_SECONDS=60
PROBE_US_EAST_URL=https://probe-us.example.com
PROBE_US_WEST_URL=https://probe-us-west.example.com
PROBE_CANADA_CENTRAL_URL=https://probe-canada.example.com
PROBE_EU_WEST_URL=https://probe-eu.example.com
PROBE_EU_NORTH_URL=https://probe-eu-north.example.com
PROBE_EU_SOUTH_URL=https://probe-eu-south.example.com
PROBE_ASIA_URL=https://probe-asia.example.com
PROBE_ASIA_EAST_URL=https://probe-asia-east.example.com
PROBE_ASIA_SOUTH_URL=https://probe-asia-south.example.com
SCHEDULER_POLL_INTERVAL_MS=1000
SCHEDULER_INSTANCE_ID=local-1
SCHEDULER_MAX_CONCURRENT_PROBES=32

# Per-deployment Worker values
PROBE_REGION=us-east
PROBE_MAX_REQUEST_BYTES=65536
PROBE_VERSION=dev
